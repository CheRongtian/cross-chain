pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {PBFTCertificateVerifier} from "../src/PBFTCertificateVerifier.sol";
import {ValidatorSetRegistry} from "../src/ValidatorSetRegistry.sol";
import {IPBFTCertificateVerifier} from "../src/interfaces/IPBFTCertificateVerifier.sol";
import {PBFTCertificateCodec as Codec} from "../src/libraries/PBFTCertificateCodec.sol";

contract PBFTCertificateVerifierTest is Test {
    uint256 private constant COMMITTEE_SIZE = 4;
    uint256 private constant QUORUM = 3;
    uint256 private constant WORD = 32;
    uint256 private constant SIGNATURE_OFFSET = WORD * QUORUM;
    uint256 private constant SIGNATURE_DATA_OFFSET = SIGNATURE_OFFSET + WORD;
    uint256 private constant SIGNATURE_PADDING_OFFSET = SIGNATURE_DATA_OFFSET + WORD * 2;
    uint256 private constant HEAD_SIZE = 128;
    uint256 private constant V3_AUTHORITY_OFFSET = HEAD_SIZE + WORD * 9;
    uint256 private constant MESSAGE_ROOT_FIELD_INDEX = 6;
    uint256 private constant MALFORMED_ENCODING_CASE_COUNT = 10;
    uint256 private constant TRUNCATED_FRAME_CASE_COUNT = 6;
    uint256 private constant INVALID_RECOVERY_CASE_COUNT = 6;
    uint256 private constant SIGNATURE_LENGTH = 65;
    uint256 private constant TUPLE_SIZE = 224;
    uint256 private constant FIRST_EPOCH = 7;
    uint256 private constant SECOND_EPOCH = FIRST_EPOCH + 1;
    uint256 private constant LARGE_EPOCH = (1 << 200) + FIRST_EPOCH;
    uint256 private constant CURRENT_CASE = 4;
    uint256 private constant CURRENT_FOUR_CASE = CURRENT_CASE + 1;
    uint256 private constant CURVE_ORDER = 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141;
    bytes32 private constant GENERATOR_X = 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798;
    uint8 private constant RECOVERY_BASE = 27;
    address private constant UNKNOWN_ADDRESS = address(0xBAD);

    ValidatorSetRegistry private registry;
    PBFTCertificateVerifier private verifier;
    string private golden;

    function setUp() public {
        // Only frozen public vectors are read; no expected signature or digest is generated by Solidity.
        // forge-lint: disable-next-line(unsafe-cheatcode)
        golden = vm.readFile(string.concat(vm.projectRoot(), "/../test-vectors/pbft-certificates.json"));
        registry = new ValidatorSetRegistry(address(this));
        registry.registerValidatorSet(FIRST_EPOCH, _committee(0));
        registry.registerValidatorSet(SECOND_EPOCH, _committee(1));
        verifier = new PBFTCertificateVerifier(address(registry));
    }

    function testConstructorBindsRegistryAndRejectsInvalidDependency() public {
        assertEq(address(verifier.validatorSetRegistry()), address(registry));
        vm.expectRevert(PBFTCertificateVerifier.InvalidValidatorSetRegistry.selector);
        new PBFTCertificateVerifier(address(0));
        vm.expectRevert(PBFTCertificateVerifier.InvalidValidatorSetRegistry.selector);
        new PBFTCertificateVerifier(UNKNOWN_ADDRESS);
    }

    // Bounded fixture loop deliberately calls the local verifier and VM for each frozen case.
    // forge-lint: disable-next-item(calls-loop)
    function testAllSharedGoldenVectors() public {
        uint256 count = vm.parseJsonUint(golden, ".caseCount");
        for (uint256 index = 0; index < count; ++index) {
            bytes memory encoded = _encoded(index);
            IPBFTCertificateVerifier.ExpectedContext memory expected = _expected(index);
            bool valid = vm.parseJsonBool(golden, string.concat(_casePath(index), ".valid"));
            if (valid) {
                assertTrue(verifier.verifyCertificate(encoded, expected),
                    vm.parseJsonString(golden, string.concat(_casePath(index), ".name")));
            } else {
                vm.expectRevert();
                // The VM checks the revert; invalid cases have no return value to consume.
                // forge-lint: disable-next-line(unused-return)
                verifier.verifyCertificate(encoded, expected);
            }
        }
    }

    // Each mismatch changes one trusted caller field without changing the certified bytes.
    // forge-lint: disable-next-item(calls-loop)
    function testEveryTrustedContextFieldIsRequired() public {
        bytes memory encoded = _encoded(CURRENT_CASE);
        for (uint256 field = 0; field < 8; ++field) {
            IPBFTCertificateVerifier.ExpectedContext memory expected = _expected(CURRENT_CASE);
            if (field == 0) expected.protocolVersion = Codec.VIEW_VERSION;
            else if (field == 1) ++expected.sourceDomain;
            else if (field == 2) expected.sourceGateway = UNKNOWN_ADDRESS;
            else if (field == QUORUM) ++expected.batchEpoch;
            else if (field == COMMITTEE_SIZE) ++expected.viewNumber;
            else if (field == 5) expected.batchId = bytes32(uint256(expected.batchId) ^ 1);
            else if (field == MESSAGE_ROOT_FIELD_INDEX) expected.messageRoot = bytes32(uint256(expected.messageRoot) ^ 1);
            else ++expected.authorityEpoch;
            vm.expectRevert(PBFTCertificateVerifier.ContextMismatch.selector);
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, expected);
        }
    }

    function testOldAndLegacyEvidenceSurvivesRotationWithoutLatestFallback() public {
        assertEq(registry.latestValidatorEpoch(), SECOND_EPOCH);
        assertTrue(verifier.verifyCertificate(_encoded(0), _expected(0)));
        assertTrue(verifier.verifyCertificate(_encoded(2), _expected(2)));
        assertTrue(verifier.verifyCertificate(_encoded(CURRENT_CASE), _expected(CURRENT_CASE)));
        registry.registerValidatorSet(SECOND_EPOCH + 1, _committee(1));
        assertTrue(verifier.verifyCertificate(_encoded(CURRENT_CASE), _expected(CURRENT_CASE)));
        IPBFTCertificateVerifier.ExpectedContext memory expected = _expected(0);
        expected.authorityEpoch = SECOND_EPOCH;
        vm.expectRevert(PBFTCertificateVerifier.LegacyAuthorityMismatch.selector);
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(_encoded(0), expected);
        expected = _expected(0);
        expected.protocolVersion = Codec.EPOCH_VERSION;
        vm.expectRevert(PBFTCertificateVerifier.ContextMismatch.selector);
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(_encoded(0), expected);
    }

    function testUnknownAndUninitializedAuthorityRevertWithoutFallback() public {
        IPBFTCertificateVerifier.ExpectedContext memory expected = _expected(CURRENT_CASE);
        expected.authorityEpoch = SECOND_EPOCH + 1;
        bytes memory encoded = _encoded(CURRENT_CASE);
        _putWord(encoded, V3_AUTHORITY_OFFSET, expected.authorityEpoch);
        vm.expectRevert(abi.encodeWithSelector(ValidatorSetRegistry.UnknownValidatorEpoch.selector, expected.authorityEpoch));
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(encoded, expected);

        ValidatorSetRegistry empty = new ValidatorSetRegistry(address(this));
        PBFTCertificateVerifier uninitialized = new PBFTCertificateVerifier(address(empty));
        vm.expectRevert(ValidatorSetRegistry.ValidatorHistoryNotInitialized.selector);
        // forge-lint: disable-next-line(unused-return)
        uninitialized.verifyCertificate(_encoded(0), _expected(0));
    }

    // The legacy format signs the committee, not an epoch field; metadata anchors it exactly.
    // forge-lint: disable-next-item(calls-loop)
    function testLegacyAuthorityAnchorSupportsZeroAndFullWidthEpochs() public {
        uint256[2] memory anchors = [uint256(0), LARGE_EPOCH];
        for (uint256 index = 0; index < anchors.length; ++index) {
            ValidatorSetRegistry historical = new ValidatorSetRegistry(address(this));
            historical.registerValidatorSet(anchors[index], _committee(0));
            PBFTCertificateVerifier historicalVerifier = new PBFTCertificateVerifier(address(historical));
            IPBFTCertificateVerifier.ExpectedContext memory expected = _expected(0);
            expected.authorityEpoch = anchors[index];
            assertTrue(historicalVerifier.verifyCertificate(_encoded(0), expected));
            historical.registerValidatorSet(anchors[index] + 1, _committee(1));
            assertTrue(historicalVerifier.verifyCertificate(_encoded(0), expected));
        }
    }

    // Unknown full-width signed epochs must reach exact lookup, without truncation or fallback.
    // forge-lint: disable-next-item(calls-loop)
    function testFullWidthV3AuthorityIsNeverNarrowed() public {
        uint256[2] memory epochs = [LARGE_EPOCH, type(uint256).max];
        for (uint256 index = 0; index < epochs.length; ++index) {
            IPBFTCertificateVerifier.ExpectedContext memory expected = _expected(CURRENT_CASE);
            expected.authorityEpoch = epochs[index];
            bytes memory encoded = _encoded(CURRENT_CASE);
            _putWord(encoded, V3_AUTHORITY_OFFSET, epochs[index]);
            vm.expectRevert(abi.encodeWithSelector(ValidatorSetRegistry.UnknownValidatorEpoch.selector, epochs[index]));
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, expected);
        }
    }

    // The local staticcall confirms no event or state-writing path is required for verification.
    function testReadOnlyVerificationEmitsNoEventsAndPreservesAuthority() public {
        vm.recordLogs();
        // A low-level call is required here to assert actual EVM STATICCALL compatibility.
        // Suppress only this complete multi-line expression; success and the decoded result are checked.
        // forge-lint: disable-start(low-level-calls)
        (bool success, bytes memory result) = address(verifier).staticcall(abi.encodeCall(
            IPBFTCertificateVerifier.verifyCertificate, (_encoded(CURRENT_CASE), _expected(CURRENT_CASE))
        ));
        // forge-lint: disable-end(low-level-calls)
        assertTrue(success);
        assertTrue(abi.decode(result, (bool)));
        assertEq(vm.getRecordedLogs().length, 0);
        assertEq(registry.initialValidatorEpoch(), FIRST_EPOCH);
        assertEq(registry.latestValidatorEpoch(), SECOND_EPOCH);
    }

    // Bounded local mutation cases cover canonical offsets, widths, lengths and padding.
    // forge-lint: disable-next-item(calls-loop)
    function testMalformedEncodingOffsetsWidthsAndPadding() public {
        bytes memory original = _encoded(CURRENT_CASE);
        uint256 arrayOffset = _getWord(original, SIGNATURE_OFFSET);
        uint256 arrayStart = arrayOffset + WORD;
        uint256 tuple = arrayStart + QUORUM * WORD;
        uint256[MALFORMED_ENCODING_CASE_COUNT] memory offsets = [
            WORD, SIGNATURE_OFFSET, HEAD_SIZE, HEAD_SIZE + WORD * 2, arrayStart,
            arrayStart + WORD, tuple, tuple + WORD * 2, tuple + SIGNATURE_PADDING_OFFSET,
            arrayOffset
        ];
        uint256[MALFORMED_ENCODING_CASE_COUNT] memory values = [
            uint256(HEAD_SIZE + WORD), arrayOffset + WORD, uint256(0), type(uint256).max,
            uint256(0), QUORUM * WORD, type(uint256).max, uint256(0), uint256(1), type(uint256).max
        ];
        for (uint256 index = 0; index < offsets.length; ++index) {
            bytes memory encoded = _encoded(CURRENT_CASE);
            _putWord(encoded, offsets[index], values[index]);
            vm.expectRevert();
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
        }
        bytes memory trailing = bytes.concat(original, hex"00");
        vm.expectRevert(Codec.InvalidCertificateEncoding.selector);
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(trailing, _expected(CURRENT_CASE));
    }

    // Every shortened canonical frame must fail before any trusted result is returned.
    // forge-lint: disable-next-item(calls-loop)
    function testTruncatedAndOversizedFramesAreRejected() public {
        bytes memory original = _encoded(CURRENT_CASE);
        uint256[TRUNCATED_FRAME_CASE_COUNT] memory lengths = [
            uint256(0), WORD, HEAD_SIZE - 1, HEAD_SIZE, V3_AUTHORITY_OFFSET + WORD - 1, original.length - 1
        ];
        for (uint256 index = 0; index < lengths.length; ++index) {
            bytes memory truncated = new bytes(lengths[index]);
            for (uint256 position = 0; position < truncated.length; ++position) truncated[position] = original[position];
            vm.expectRevert(Codec.InvalidCertificateEncoding.selector);
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(truncated, _expected(CURRENT_CASE));
        }
        vm.expectRevert(Codec.InvalidCertificateEncoding.selector);
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(new bytes(1505), _expected(CURRENT_CASE));
    }

    // Versions include dirty uint8 bits; they cannot select an unintended decoder.
    // forge-lint: disable-next-item(calls-loop)
    function testUnsupportedVersionsAndEvidenceBounds() public {
        uint256[COMMITTEE_SIZE] memory versions = [uint256(0), COMMITTEE_SIZE, uint256(256), type(uint256).max];
        for (uint256 index = 0; index < versions.length; ++index) {
            bytes memory encoded = _encoded(CURRENT_CASE);
            _putWord(encoded, 0, versions[index]);
            vm.expectRevert(abi.encodeWithSelector(Codec.UnsupportedProtocolVersion.selector, versions[index]));
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
        }
        uint256[COMMITTEE_SIZE] memory counts = [uint256(0), uint256(2), COMMITTEE_SIZE + 1, type(uint256).max];
        for (uint256 index = 0; index < counts.length; ++index) {
            bytes memory encoded = _encoded(CURRENT_CASE);
            _putWord(encoded, _getWord(encoded, SIGNATURE_OFFSET), counts[index]);
            vm.expectRevert(abi.encodeWithSelector(Codec.InvalidEvidenceCount.selector, counts[index]));
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
        }
    }

    // Actual transport requires full 65-byte signatures, not compact EIP-2098 evidence.
    // forge-lint: disable-next-item(calls-loop)
    function testSignatureLengthRecoveryAndScalarBoundaries() public {
        bytes memory original = _encoded(CURRENT_CASE);
        uint256 tuple = _getWord(original, SIGNATURE_OFFSET) + WORD + QUORUM * WORD;
        uint256[QUORUM] memory lengths = [uint256(0), SIGNATURE_LENGTH - 1, SIGNATURE_LENGTH + 1];
        for (uint256 index = 0; index < lengths.length; ++index) {
            bytes memory encoded = _encoded(CURRENT_CASE);
            _putWord(encoded, tuple + SIGNATURE_OFFSET, lengths[index]);
            vm.expectRevert(abi.encodeWithSelector(Codec.InvalidSignatureLength.selector, lengths[index]));
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
        }
        uint256 signature = tuple + SIGNATURE_DATA_OFFSET;
        uint8[INVALID_RECOVERY_CASE_COUNT] memory recovery = [
            uint8(2), Codec.EPOCH_VERSION, uint8(26), uint8(29), uint8(35), uint8(255)
        ];
        for (uint256 index = 0; index < recovery.length; ++index) {
            bytes memory encoded = _encoded(CURRENT_CASE);
            encoded[signature + SIGNATURE_LENGTH - 1] = bytes1(recovery[index]);
            vm.expectRevert(abi.encodeWithSelector(PBFTCertificateVerifier.InvalidSignature.selector, 0));
            // forge-lint: disable-next-line(unused-return)
            verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
        }
        uint256[2] memory scalars = [uint256(0), CURVE_ORDER];
        for (uint256 part = 0; part < scalars.length; ++part) {
            for (uint256 index = 0; index < scalars.length; ++index) {
                bytes memory encoded = _encoded(CURRENT_CASE);
                _putWord(encoded, signature + part * WORD, scalars[index]);
                vm.expectRevert(abi.encodeWithSelector(PBFTCertificateVerifier.InvalidSignature.selector, 0));
                // forge-lint: disable-next-line(unused-return)
                verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
            }
        }
    }

    function testExtraEvidenceIsAlwaysAuthenticated() public {
        bytes memory encoded = _encoded(CURRENT_FOUR_CASE);
        uint256 tuple = _getWord(encoded, SIGNATURE_OFFSET) + WORD + COMMITTEE_SIZE * WORD + (COMMITTEE_SIZE - 1) * TUPLE_SIZE;
        _putWord(encoded, tuple + WORD, 0);
        vm.expectRevert(abi.encodeWithSelector(PBFTCertificateVerifier.CommitDigestMismatch.selector, COMMITTEE_SIZE - 1));
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(encoded, _expected(CURRENT_FOUR_CASE));
    }

    function testZeroRecoveredIdentityWithInRangeScalarsIsRejected() public {
        bytes32 signingDigest = vm.parseJsonBytes32(golden,
            string.concat(_casePath(CURRENT_CASE), ".signingDigests[0]"));
        uint256 s = uint256(signingDigest) % CURVE_ORDER;
        assertGt(s, 0);
        // R = G and s = hash mod n make sR - hash*G the point at infinity.
        // This fixture deliberately exercises zero recovery with in-range s, including high-s values.
        // forge-lint: disable-next-line(ecrecover)
        assertEq(ecrecover(signingDigest, RECOVERY_BASE, GENERATOR_X, bytes32(s)), address(0));
        bytes memory encoded = _encoded(CURRENT_CASE);
        uint256 signature = _getWord(encoded, SIGNATURE_OFFSET) + WORD + QUORUM * WORD + SIGNATURE_DATA_OFFSET;
        _putWord(encoded, signature, uint256(GENERATOR_X));
        _putWord(encoded, signature + WORD, s);
        encoded[signature + SIGNATURE_LENGTH - 1] = bytes1(RECOVERY_BASE);
        vm.expectRevert(abi.encodeWithSelector(PBFTCertificateVerifier.InvalidSignature.selector, 0));
        // forge-lint: disable-next-line(unused-return)
        verifier.verifyCertificate(encoded, _expected(CURRENT_CASE));
    }

    // Local VM formatting is deliberately used by the bounded public-fixture loops.
    // forge-lint: disable-next-item(calls-loop)
    function _casePath(uint256 index) private pure returns (string memory) {
        return string.concat(".cases[", vm.toString(index), "]");
    }

    // Each fixture iteration reads frozen public bytes through the VM, without production external calls.
    // forge-lint: disable-next-item(calls-loop)
    function _encoded(uint256 index) private view returns (bytes memory) {
        return vm.parseJsonBytes(golden, string.concat(_casePath(index), ".encoded"));
    }

    // Bounded fixture loops need VM JSON reads and an immediate width guard before uint8 conversion.
    // forge-lint: disable-next-item(calls-loop, require-revert-in-loop)
    function _expected(uint256 index) private view returns (IPBFTCertificateVerifier.ExpectedContext memory expected) {
        string memory prefix = string.concat(_casePath(index), ".expected.");
        // The shared fixture uses decimal strings to preserve full-width JSON integers.
        uint256 version = _integer(string.concat(prefix, "protocolVersion"));
        require(version <= type(uint8).max, "fixture version width");
        // The explicit width assertion guards this fixture-only conversion.
        // forge-lint: disable-next-line(unsafe-typecast)
        expected.protocolVersion = uint8(version);
        expected.sourceDomain = _integer(string.concat(prefix, "sourceDomain"));
        expected.sourceGateway = vm.parseJsonAddress(golden, string.concat(prefix, "sourceGateway"));
        expected.batchEpoch = _integer(string.concat(prefix, "batchEpoch"));
        expected.viewNumber = _integer(string.concat(prefix, "view"));
        expected.batchId = vm.parseJsonBytes32(golden, string.concat(prefix, "batchId"));
        expected.messageRoot = vm.parseJsonBytes32(golden, string.concat(prefix, "messageRoot"));
        expected.authorityEpoch = _integer(string.concat(prefix, "authorityEpoch"));
    }

    // Decimal strings preserve full uint256 precision; these VM reads are intentional inside fixture loops.
    // forge-lint: disable-next-item(calls-loop)
    function _integer(string memory path) private view returns (uint256) {
        return vm.parseUint(vm.parseJsonString(golden, path));
    }

    // Bounded fixture setup reads the shared committee through the VM, including loop-driven registry cases.
    // forge-lint: disable-next-item(calls-loop)
    function _committee(uint256 index) private view returns (address[COMMITTEE_SIZE] memory members) {
        address[] memory parsed = vm.parseJsonAddressArray(golden, string.concat(".history[", vm.toString(index), "].validators"));
        assertEq(parsed.length, COMMITTEE_SIZE);
        for (uint256 position = 0; position < COMMITTEE_SIZE; ++position) members[position] = parsed[position];
    }

    // Every bounded mutation-loop write retains a guard against changing memory outside the fixture.
    // forge-lint: disable-next-item(require-revert-in-loop)
    function _putWord(bytes memory encoded, uint256 offset, uint256 value) private pure {
        require(offset + WORD <= encoded.length, "fixture word bounds");
        // Mutate one bounded test ABI word without changing the frame allocation.
        // forge-lint: disable-next-line(inline-assembly)
        assembly ("memory-safe") {
            mstore(add(add(encoded, WORD), offset), value)
        }
    }

    // Every bounded mutation-loop read retains the same fixture memory bounds.
    // forge-lint: disable-next-item(require-revert-in-loop)
    function _getWord(bytes memory encoded, uint256 offset) private pure returns (uint256 value) {
        require(offset + WORD <= encoded.length, "fixture word bounds");
        // Inspect one bounded test ABI word for transport-specific mutations.
        // forge-lint: disable-next-line(inline-assembly)
        assembly ("memory-safe") {
            value := mload(add(add(encoded, WORD), offset))
        }
    }
}
