# Put an actual password only in ignored .env. The interactive local stack
# creates fresh schemas in this existing database. If DATABASE_URL is empty,
# start.sh creates its own loopback PostgreSQL cluster using installed tools.
# verify.sh retains its existing configured database prerequisite; its clean
# bootstrap demonstration always owns a separate temporary PostgreSQL cluster.
DATABASE_URL='postgresql://cross_chain_indexer:replace-with-local-password@127.0.0.1:5432/cross_chain_indexer_test'
INDEXER_DB_SCHEMA='cross_chain_indexer_verification'
INDEXER_BLOCK_RANGE='2'
INDEXER_POLL_INTERVAL_MS='100'
FINALITY_BLOCK_DEPTH='2'
FINALITY_POLL_INTERVAL_MS='100'

# Verification injects four normal validators and five rotation identities at runtime.
# It uses DATABASE_URL with isolated validator schemas by default; no additional password is required.
# Optional separate local verification database (never put a real password in this example):
# VALIDATOR_VERIFICATION_DATABASE_URL='postgresql://replace-user:replace-password@127.0.0.1:5432/replace-database'

# Consensus progress timeout; independent of HTTP request timeouts.
PBFT_VIEW_TIMEOUT_MS=30000
# Validator-set history is public operator configuration. Each process owns only
# its own private key; endpoint directory membership does not grant voting rights.
# Configure one history source for production validator startup. For the API,
# relative history paths resolve from the project root, including npm --prefix
# indexer runs. This example is a reference; use the actual deployment history.
# Verification injects its own explicit public schedules and never changes .env.
VALIDATOR_SET_HISTORY_FILE=validator/config/validator-set-history.example.json

# Destination transaction management. Verification injects its funded development
# signer; put a real local secret only in the ignored .env, never in this example.
CHAIN_B_RPC_URL='http://127.0.0.1:9545'
CHAIN_A_RPC_URL='http://127.0.0.1:4545'
# start.sh owns fresh local chains on these ports and will not attach to an
# unrelated listener. Local source/destination IDs remain 10011 and 2001.
# Native observation binaries must already be installed; no automatic download.
# PROMETHEUS_BIN='/absolute/path/to/prometheus'
# GRAFANA_BIN='/absolute/path/to/grafana'
# GRAFANA_HOME='/absolute/path/to/share/grafana'
PROMETHEUS_PORT='9090'
GRAFANA_PORT='3000'
LOCAL_VALIDATOR_BASE_PORT='31001'
LOCAL_METRICS_BASE_PORT='9101'
# Optional ordered access paths to the same chain. They must already exist:
# CHAIN_B_RPC_URLS='["http://127.0.0.1:9545","http://127.0.0.1:9546"]'
CHAIN_B_CHAIN_ID='2001'
# Required for production workers. Verification injects the local chain's actual
# genesis and creates two temporary access paths; it never updates your .env.
CHAIN_B_GENESIS_HASH=''
RPC_REQUEST_TIMEOUT_MS='10000'
RELAYER_A_PRIVATE_KEY=''
# Both workers share this destination signer and nonce space. Their operational
# IDs must differ; the verification script supplies both IDs automatically.
RELAYER_WORKER_ID='relayer-a'
RELAYER_LEASE_MS='30000'
RELAYER_MAX_JOBS_PER_RUN='100'
# The bounded transaction recovery pass reuses this limit; no crash toggles.
DESTINATION_CONFIRMATIONS='3'

# Durable bounded retry; intervals are milliseconds and fee caps are wei.
TX_REBROADCAST_INTERVAL_MS='5000'
TX_REPLACEMENT_AFTER_MS='60000'
TX_FEE_BUMP_NUMERATOR='9'
TX_FEE_BUMP_DENOMINATOR='8'
TX_MAX_ATTEMPTS='4'
TX_MAX_FEE_PER_GAS='100000000000'
TX_MAX_PRIORITY_FEE_PER_GAS='10000000000'

# Read-only lifecycle API. No signer private key or RPC connection is used by GET.
MESSAGE_QUERY_API_HOST='127.0.0.1'
MESSAGE_QUERY_API_PORT='8080'
# API/Explorer and each Validator expose /metrics on their existing HTTP port.
# CLI Indexer/Finality/Relayer/Transaction Manager may opt into a same-process
# loopback metrics listener. Leave empty to disable; assign a distinct port per
# simultaneously running CLI process. A one-shot listener ends with that run.
METRICS_HOST='127.0.0.1'
METRICS_PORT=''
# Required for independent API startup: set the actual source scope. Verification
# injects these values into its own processes; it never persists them to .env.
CHAIN_A_DOMAIN='10011'
SOURCE_GATEWAY_ADDRESS=''
# Public identity of the deployed production IdentityApplicationA. Without a
# matching source path, authorization evidence is shown as unavailable.
IDENTITY_APPLICATION_ADDRESS=''
# Public production Gateway identity: only its authenticated execute(bytes)
# receipts can be labelled execution CONFIRMED. Other receipts remain transport-only.
PRODUCTION_DESTINATION_GATEWAY_ADDRESS=''
# Read stores use DATABASE_URL unless a separate databaseUrl is supplied.
# Configure public historical validator identities and their existing schemas.
# Leave real connection secrets only in the ignored .env, never this example.
MESSAGE_QUERY_VALIDATOR_STORES='[]'
# Example structure (replace the public address/schema with actual runtime values):
# MESSAGE_QUERY_VALIDATOR_STORES='[{"validatorAddress":"0x1111111111111111111111111111111111111111","databaseSchema":"validator_identity_one"}]'
