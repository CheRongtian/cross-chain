{
  "modelVersion": 1,
  "canonicalCredentialFields": [
    {
      "name": "subject",
      "type": "utf8-string"
    },
    {
      "name": "issuer",
      "type": "utf8-string"
    },
    {
      "name": "role",
      "type": "utf8-string"
    },
    {
      "name": "expiry",
      "type": "uint64-unix-seconds"
    },
    {
      "name": "credentialId",
      "type": "utf8-string"
    }
  ],
  "privacy": {
    "default": "private",
    "userHeld": true,
    "privateByDefault": [
      "subject",
      "issuer",
      "role",
      "expiry",
      "credentialId"
    ],
    "policyDisclosure": "The authorization proof exposes only credentialCommitment, trustedIssuer, requiredRole, and currentTimestamp."
  },
  "expiry": {
    "representation": "unix-seconds",
    "validWhen": "evaluationTime < expiry",
    "expiredWhen": "evaluationTime >= expiry"
  },
  "roles": {
    "expectedExample": "VERIFIED_SUPPLIER",
    "representation": "uppercase token"
  },
  "issuerTrust": {
    "identifierField": "issuer",
    "trustStates": [true, false],
    "fixtureSource": "trusted-issuers.json",
    "includedInCredential": false
  },
  "revocation": {
    "field": "status",
    "states": ["ACTIVE", "REVOKED"],
    "enforcementImplemented": false
  },
  "credentialCommitment": {
    "canonicalName": "credentialCommitment",
    "preimageVersion": 1,
    "preimageKind": "ordered-typed-field-sequence",
    "fields": [
      {
        "name": "subject",
        "type": "utf8-string"
      },
      {
        "name": "issuer",
        "type": "utf8-string"
      },
      {
        "name": "role",
        "type": "utf8-string"
      },
      {
        "name": "expiry",
        "type": "uint64-unix-seconds"
      },
      {
        "name": "credentialId",
        "type": "utf8-string"
      }
    ],
    "excludedFields": ["status", "issuerTrusted"],
    "hashPrimitive": "Poseidon(6)-BN254",
    "hashInputs": [
      "preimageVersion",
      "subjectField",
      "issuerField",
      "roleField",
      "expiry",
      "credentialIdField"
    ],
    "encodingSpecification": "../encoding.json",
    "outputRepresentation": "unsigned decimal BN254 field element",
    "cryptographicSelectionDeferred": false
  }
}
