# Production/operator template for one validator. Each committee has four members.
# Secrets belong only in an ignored local .env or the process environment.
VALIDATOR_PRIVATE_KEY='replace-with-private-secp256k1-key'
VALIDATOR_LISTEN_HOST='127.0.0.1'
VALIDATOR_LISTEN_PORT='31001'
VALIDATOR_DATABASE_URL='postgresql://replace-user:replace-password@127.0.0.1:5432/replace-database'
VALIDATOR_DB_SCHEMA='validator_local_v1'
SOURCE_DATABASE_URL='postgresql://replace-user:replace-password@127.0.0.1:5432/replace-source-database'
SOURCE_DB_SCHEMA='cross_chain_indexer'
CHAIN_A_RPC_URL='http://127.0.0.1:4545'
CHAIN_A_DOMAIN='10011'
SOURCE_GATEWAY_ADDRESS='replace-with-deployed-source-gateway-address'
FINALITY_BLOCK_DEPTH='2'
# Replace all four public addresses with identities derived from your four independent keys.
VALIDATOR_PEERS='[{"address":"replace-v1-public-address","url":"http://127.0.0.1:31001"},{"address":"replace-v2-public-address","url":"http://127.0.0.1:31002"},{"address":"replace-v3-public-address","url":"http://127.0.0.1:31003"},{"address":"replace-v4-public-address","url":"http://127.0.0.1:31004"}]'
VALIDATOR_SET_HISTORY_FILE='replace-with-absolute-path-to-public-validator-history.json'
# Alternatively set VALIDATOR_SET_HISTORY to the same public JSON array and
# leave VALIDATOR_SET_HISTORY_FILE unset. Configure exactly one history source.
# The endpoint directory may include upcoming/removed identities; committee
# membership comes only from the history, never endpoint availability.

# Progress timeout for a PBFT view, separate from HTTP timeouts.
PBFT_VIEW_TIMEOUT_MS=30000
